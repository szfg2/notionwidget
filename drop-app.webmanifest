{
  "id": "./drop.html?installed",
  "name": "Drop",
  "short_name": "Drop",
  "description": "Pass text and pictures between your devices.",
  "start_url": "./drop.html?installed",
  "scope": "./drop",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#171817",
  "theme_color": "#171817",
  "lang": "en",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "drop-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "drop-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "drop-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./drop.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".heic", ".heif"] }
      ]
    }
  }
}
